PORT=3000
HOST=0.0.0.0
TOKEN_SECRET=change-me-to-a-long-random-hex-string-at-least-64-chars
TOKEN_DENOMINATION=10
TOKEN_EXPIRY_DAYS=30
ESCROW_BANK_NAME=ZeroNetPay Escrow
# The real UPI ID that receives money during the "Load" step.
# In production this is your business / PPI escrow account.
# You can also leave this blank and configure it through the in-app Settings screen.
ESCROW_UPI_ID=
NODE_ENV=production
